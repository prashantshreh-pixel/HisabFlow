# HisabFlow Environment Configuration Example
# Copy this file to .env.local for local development overrides.
# Never commit real API keys or secrets to version control.

# Canonical public URL of the deployed application
NEXT_PUBLIC_APP_URL="https://hisabflow.com"

# Optional backend API base URL override (leave blank when served from same origin)
# NEXT_PUBLIC_API_BASE_URL="http://localhost:5200"
